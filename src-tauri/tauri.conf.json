{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mosaic Drive",
  "version": "0.1.0",
  "identifier": "com.jody.mosaic-drive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mosaic Drive",
        "width": 920,
        "height": 700,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREMDA2MjZDRENDNDFERTUKUldUbEhjVGNiR0lBVFJhZHlrNWczZ2l3UXRqOTVZcGJhT3JzSmpXNzBESHpHZng3dkJITGt4bkQK",
      "endpoints": [
        "https://github.com/mosaic-site-apps/mosaic-drive/releases/latest/download/latest.json"
      ]
    }
  }
}